{
    "scenarios": [
        {
            "name": "S0: Predictable Start + State Verification",
            "description": "Verify all elevators are homed to floor 0, then inject a cab order and verify movement.",
            "steps": [
                {
                    "action": "verify_state_live",
                    "label": "all-homed",
                    "timeout": 10.0,
                    "expected": {
                        "elev1": {
                            "floor": 0,
                            "behaviour": "idle"
                        },
                        "elev2": {
                            "floor": 0,
                            "behaviour": "idle"
                        },
                        "elev3": {
                            "floor": 0,
                            "behaviour": "idle"
                        }
                    }
                },
                {
                    "action": "inject_order",
                    "type": "cab",
                    "floor": 3,
                    "node_id": "elev1"
                },
                {
                    "action": "verify_state_live",
                    "label": "elev1-moving-up",
                    "timeout": 5.0,
                    "expected": {
                        "elev1": {
                            "behaviour": "moving",
                            "direction": "up"
                        }
                    }
                },
                {
                    "action": "wait_for_live_state",
                    "timeout": 15.0,
                    "expected": {
                        "elev1": {
                            "floor": 3,
                            "behaviour": [
                                "doorOpen",
                                "idle"
                            ]
                        }
                    }
                },
                {
                    "action": "verify_state_live",
                    "label": "elev1-at-floor-3",
                    "timeout": 5.0,
                    "expected": {
                        "elev1": {
                            "floor": 3
                        }
                    }
                }
            ]
        },
        {
            "name": "S1: Hall-order failover",
            "description": "Hall Down floor 3 injected; the assigned elevator is killed before it arrives. A peer must take over.",
            "verifications": [
                {
                    "type": "hall_order_served",
                    "floor": 3,
                    "direction": 1
                },
                {
                    "type": "hall_order_served_within",
                    "floor": 3,
                    "direction": 1,
                    "max_seconds": 30.0
                },
                {
                    "type": "no_order_stuck",
                    "max_idle_seconds": 35.0
                }
            ],
            "steps": [
                {
                    "action": "inject_order",
                    "type": "hall_down",
                    "floor": 3,
                    "node_id": "elev1"
                },
                {
                    "action": "wait_for_live_state",
                    "timeout": 8.0,
                    "expected": {
                        "elev1": {"behaviour": "moving"}
                    }
                },
                {
                    "action": "kill_node",
                    "node_id": "elev1"
                },
                {
                    "action": "wait_for_live_state",
                    "timeout": 25.0,
                    "expected": {
                        "elev2": {"floor": 3}
                    }
                },
                {
                    "action": "sleep",
                    "duration": 5
                },
                {
                    "action": "verify_logs_extended",
                    "checks": []
                },
                {
                    "action": "start_node",
                    "node_id": "elev1"
                },
                {
                    "action": "sleep",
                    "duration": 2
                }
            ]
        },
        {
            "name": "S2: Cab-order resurrection (single floor)",
            "description": "elev1 registers a cab order, is immediately killed, then revived. Peers must preserve its state; it must merge and serve on return.",
            "verifications": [
                {
                    "type": "cab_order_served",
                    "node_id": "elev1",
                    "floor": 1
