                    "floor": 1,
                    "max_seconds": 20.0
                },
                {
                    "type": "behaviour_sequence",
                    "node_id": "elev1",
                    "sequence": [
                        "moving",
                        "doorOpen",
                        "idle"
                    ]
                }
            ],
            "steps": [
                {
                    "action": "inject_order",
                    "type": "cab",
                    "floor": 1,
                    "node_id": "elev1"
