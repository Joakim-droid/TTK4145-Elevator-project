                {
                    "action": "sleep",
                    "duration": 0.3
                },
                {
                    "action": "kill_node",
                    "node_id": "elev1"
                },
                {
                    "action": "sleep",
                    "duration": 2
                },
                {
                    "action": "start_node",
                    "node_id": "elev1"
                },
                {
                    "action": "wait_for_live_state",
                    "timeout": 10.0,
                    "expected": {
                        "elev1": {"behaviour": "moving"}
                    }
                },
                {
                    "action": "wait_for_live_state",
                    "timeout": 15.0,
                    "expected": {
                        "elev1": {
                            "floor": 1,
                            "behaviour": [
                                "doorOpen",
                                "idle"
                            ]
                        }
                    }
                },
                {
                    "action": "sleep",
                    "duration": 5
                },
                {
                    "action": "verify_logs_extended",
                    "checks": []
                }
            ]
        },
